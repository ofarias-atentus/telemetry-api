# Copiar a .env y ajustar. Las variables ya definidas en el entorno tienen prioridad
# sobre este archivo, incluso las definidas como vacías.
# Los valores con $, # o espacios van entre comillas simples, por ejemplo DB_PASSWORD='...'.

# Puerto del servidor HTTP (opcional, por defecto 8080)
SERVER_PORT=8080

# Obligatorias
DB_HOST=localhost
DB_USER=usuario
DB_PASSWORD=cambiar
DB_NAME=attelemetry

# Opcionales (por defecto: 5432, disable, 25 y 5)
DB_PORT=5432
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Logs (opcionales, por defecto: info y text). LOG_LEVEL: debug, info, warn o error.
# LOG_FORMAT: text o json, sin distinguir mayúsculas. Los logs salen por stderr.
# LOG_LEVEL=info
# LOG_FORMAT=text
