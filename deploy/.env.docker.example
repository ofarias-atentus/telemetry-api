# Plantilla de configuración para docker compose. Copiar como .env junto a
# docker-compose.yml y editar. No guardar credenciales reales en este archivo.
#
# Los valores con $, # o espacios deben ir entre comillas simples,
# por ejemplo: DB_PASSWORD='mi#clave $uper'
# Esta regla aplica a env_file de Docker Compose y al .env de godotenv. Con
# `docker run --env-file` las comillas NO se quitan, así que ahí los valores
# deben escribirse sin comillas (y no pueden contener saltos de línea).

# Obligatorias
# host.docker.internal apunta al PostgreSQL del servidor (ver extra_hosts).
DB_HOST=host.docker.internal
DB_USER=cambiar
DB_PASSWORD=cambiar
DB_NAME=cambiar

# Opcionales (valores por defecto)
DB_PORT=5432
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
LOG_LEVEL=info

# Tag de la imagen y puerto publicado. Docker Compose lee este archivo para
# interpolar docker-compose.yml. El paquete actualiza ATELEMETRY_MOBILE_TAG al
# actualizarse; no es necesario editarlo a mano.
ATELEMETRY_MOBILE_TAG=1.0.0
ATELEMETRY_MOBILE_PORT=8080

# LOG_FORMAT y SERVER_PORT los fija docker-compose.yml (json y 8080).
# Para cambiar el puerto publicado use ATELEMETRY_MOBILE_PORT, no SERVER_PORT.
